<div class="mt-6 flex items-center gap-4 text-sm text-skin-base/60">
  <span class="font-medium text-skin-base/70">
    Share
  </span>

  <a
    id="linkedin-share"
    href="#"
    target="_blank"
    rel="noopener noreferrer"
    class="hover:text-accent"
  >
    LinkedIn
  </a>

  <button
    id="copy-link"
    type="button"
    class="hover:text-accent"
  >
    Copy Link
  </button>

  <span
    id="copy-feedback"
    class="hidden text-xs text-accent"
    aria-live="polite"
  >
    Copied
  </span>
</div>

<script>
  let feedbackTimeout: number | undefined;
  let copyRequest = 0;

  document.addEventListener("astro:page-load", () => {
    copyRequest += 1;
    window.clearTimeout(feedbackTimeout);
    feedbackTimeout = undefined;

    const linkedin =
      document.querySelector<HTMLAnchorElement>("#linkedin-share");

    const copyButton =
      document.querySelector<HTMLButtonElement>("#copy-link");

    const feedback =
      document.querySelector<HTMLElement>("#copy-feedback");

    const currentUrl = window.location.href;

    if (linkedin) {
      linkedin.href =
        `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
    }

    copyButton?.addEventListener("click", async () => {
      const request = ++copyRequest;
      let message = "Copied";

      try {
        await navigator.clipboard.writeText(currentUrl);
      } catch {
        message = "Copy failed";
      }

      if (request !== copyRequest) return;

      feedback?.replaceChildren(message);
      feedback?.classList.remove("hidden");

      window.clearTimeout(feedbackTimeout);
      feedbackTimeout = window.setTimeout(() => {
        feedback?.classList.add("hidden");
        feedback?.replaceChildren("Copied");
        feedbackTimeout = undefined;
      }, 1500);
    });
  });
</script>

---
import { getRelativeLocaleUrl } from "astro:i18n";

import { stripBase, stripLocale } from "@/utils/withBase";

import { useTranslations } from "@/i18n";

import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const pathWithoutBase = stripBase(Astro.url.pathname).replace(/\/+$/, "");
const currentUrlPath = stripLocale(pathWithoutBase, locale);

const rawSegments = currentUrlPath.split("/").slice(1).filter(Boolean);

const decodeSegment = (value: string) => {
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
};

type BreadcrumbItem = {
  label: string;
  href?: string;
};

const breadcrumbItems: BreadcrumbItem[] = [];

/**
 * Notes
 *
 * /notes/ko/
 * /notes/en/
 * /notes/ko/2/
 * /notes/en/2/
 * /notes/ko/note-slug/
 * /notes/en/note-slug/
 */
if (rawSegments[0] === "notes") {
  const noteLanguage =
    rawSegments[1] === "en" || rawSegments[1] === "ko"
      ? rawSegments[1]
      : "ko";

  const notePath = rawSegments[2];

  breadcrumbItems.push({
    label: t.nav.notes,
    href: `/notes/${noteLanguage}/`,
  });

  if (notePath) {
    const pageNumber = Number(notePath);

    breadcrumbItems.push({
      label: !isNaN(pageNumber)
        ? `${t.pagination.page} ${pageNumber}`
        : decodeSegment(notePath),
    });
  }
}

/**
 * General pages
 */
else {
  const navLabels: Record<string, string> = {
    about: t.nav.about,
    research: "Research",
    archives: t.nav.archives,
    search: t.nav.search,
  };

  rawSegments.forEach((segment, index) => {
    const isLast = index === rawSegments.length - 1;

    breadcrumbItems.push({
      label: navLabels[segment] ?? decodeSegment(segment),
      href: isLast
        ? undefined
        : getRelativeLocaleUrl(locale, segment),
    });
  });
}
---

<nav class="app-layout mt-8 mb-1" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-1 font-light [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li class="flex items-center gap-x-1">
      <a href={getRelativeLocaleUrl(locale, "")} class="opacity-80">
        {t.nav.home}
      </a>

      {
        breadcrumbItems.length > 0 && (
          <span aria-hidden="true" class="opacity-80">
            &raquo;
          </span>
        )
      }
    </li>

    {
      breadcrumbItems.map((item, index) => {
        const isLast = index === breadcrumbItems.length - 1;

        return isLast ? (
          <li>
            <span class="opacity-75" aria-current="page">
              {item.label}
            </span>
          </li>
        ) : (
          <li class="flex items-center gap-x-1">
            <a href={item.href} class="opacity-70">
              {item.label}
            </a>

            <span aria-hidden="true" class="opacity-70">
              &raquo;
            </span>
          </li>
        );
      })
    }
  </ul>
</nav>

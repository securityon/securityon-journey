---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const startYear = 2026;
const currentYear = new Date().getFullYear();

const year = 
  currentYear === startYear 
  ? `${startYear}`
  : `${startYear}–${currentYear}`;
  ---
  
  <footer
    class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
    {...attrs}
  >
  
    <div
      class="border-border flex flex-col items-center justify-between gap-3 border-t py-6 sm:flex-row-reverse sm:py-4"
    >
      
      <Socials />
      
      <div
        class="text-foreground/70 flex flex-col items-center text-sm sm:flex-row"
      >
      
        <span>© {year} BAN Seok</span>
        <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
        <span>SecurityOn Research Journey</span>
      </div>
    </div>
  </footer>
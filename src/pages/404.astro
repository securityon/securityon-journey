---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import config from "@/config";
---

<Layout title={`404 | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <main id="main-content" class="app-layout py-8 sm:py-12">
    <section class="max-w-3xl">
      <p
        class="text-accent font-mono text-xs font-medium tracking-[0.16em] uppercase"
      >
        Document Status
      </p>

      <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Document not found
      </h1>

      <p class="text-skin-base/75 mt-4 max-w-2xl leading-7">
        The requested page could not be located in this research archive.
        It may have been moved, renamed, or is no longer available.
      </p>

      <div
        class="border-border mt-10 grid max-w-2xl gap-6 border-t pt-7 sm:grid-cols-2"
      >
        <div>
          <p
            class="text-skin-base/40 font-mono text-xs tracking-[0.14em] uppercase"
          >
            Request
          </p>

          <p class="text-skin-base/70 mt-2 break-all font-mono text-sm">
            {Astro.url.pathname}
          </p>
        </div>

        <div>
          <p
            class="text-skin-base/40 font-mono text-xs tracking-[0.14em] uppercase"
          >
            Status
          </p>

          <p class="text-skin-base/70 mt-2 font-mono text-sm">
            404 / NOT FOUND
          </p>
        </div>
      </div>

      <!-- =========================================================
           Back
      ========================================================== -->
      <section class="py-8">
        <a
          href="/"
          class="text-accent text-sm font-medium underline decoration-dashed underline-offset-4"
        >
          ← Research Journey
        </a>
      </section>
    </section>
  </main>

  <Footer />
</Layout>
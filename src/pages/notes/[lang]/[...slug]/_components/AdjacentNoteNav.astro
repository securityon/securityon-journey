---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getNoteUrl } from "@/utils/getNotePaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentNote = {
  id: string;
  title: string;
  filePath: string | undefined;
  lang: "ko" | "en";
} | null;

type Props = {
  prevNote: AdjacentNote;
  nextNote: AdjacentNote;
};

const { prevNote, nextNote } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevNote && (
      <a
        href={getNoteUrl(prevNote.id, prevNote.filePath, prevNote.lang)}
        class="flex w-full gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />

        <div>
          <span>{t.note.previousNote}</span>

          <div
            class:list={[
              "text-accent/85 text-sm",
              { "ko-ui": prevNote.lang === "ko" },
            ]}
          >
            {prevNote.title}
          </div>
        </div>
      </a>
    )
  }

  {
    nextNote && (
      <a
        href={getNoteUrl(nextNote.id, nextNote.filePath, nextNote.lang)}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span>{t.note.nextNote}</span>

          <div
            class:list={[
              "text-accent/85 text-sm",
              { "ko-ui": nextNote.lang === "ko" },
            ]}
          >
            {nextNote.title}
          </div>
        </div>

        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>